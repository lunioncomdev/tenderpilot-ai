# ── Application ──
APP_URL=http://localhost:3000
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# true derrière HTTPS (production)
COOKIE_SECURE=false
LOG_LEVEL=info

# ── Base de données / cache ──
POSTGRES_USER=tenderpilot
POSTGRES_PASSWORD=
POSTGRES_DB=tenderpilot
DATABASE_URL=postgresql://tenderpilot:CHANGER@localhost:5432/tenderpilot?schema=public
REDIS_URL=redis://localhost:6379

# ── Stockage des DCE ──
# local (dossier STORAGE_LOCAL_DIR) ou s3 (SeaweedFS du compose, ou tout service S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=tenderpilot
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=50

# ── IA (OpenAI par défaut ; AI_PROVIDER=anthropic pour Claude) ──
# Aucun appel n'est fait tant que AI_ENABLED=false. L'envoi des DCE exige en plus
# l'autorisation explicite dans Profil entreprise > Confidentialité.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-5.5
AI_EFFORT=high
AI_MONTHLY_BUDGET_USD=200
AI_MAX_DCE_TOKENS=400000

# ── Automatisations (cron, fuseau du serveur) ──
SYNC_CRON=0 */6 * * *
