generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenants & accès ─────────────────────────────

enum Plan {
  STARTER
  PRO
  AGENCY
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  plan            Plan      @default(PRO)
  /**
   * Synchronisation des sources en pause (planifiée et manuelle) depuis cette date.
   */
  syncPausedAt    DateTime?
  syncPausedById  String?
  /**
   * Clé API OpenAI propre à l'organisation (chiffrée AES-256-GCM) ; sinon OPENAI_API_KEY.
   */
  openaiApiKeyEnc String?
  /**
   * Modèle OpenAI choisi par l'organisation ; sinon AI_MODEL.
   */
  aiModel         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships      Membership[]
  profile          CompanyProfile?
  references       CompanyReference[]
  companyDocs      CompanyDocument[]
  sources          SourceConfig[]
  syncRuns         SyncRun[]
  tenders          Tender[]
  documents        TenderDocument[]
  chunks           DocumentChunk[]
  analyses         TenderAnalysis[]
  scores           TenderScore[]
  proposals        Proposal[]
  pieces           ApplicationPiece[]
  pieceFiles       ApplicationPieceFile[]
  savedSearches    SavedSearch[]
  comments         Comment[]
  auditLogs        AuditLog[]
  aiUsage          AiUsageLog[]
  sessions         Session[]
  dceSettings      DceRetrievalSettings?
  platformAccounts PlatformAccount[]
}

enum DceRetrievalMode {
  DISABLED
  ANONYMOUS
  IDENTIFIED
}

/**
 * Retrait automatique des DCE sur les profils acheteurs. En mode identifié,
 * ces coordonnées sont transmises à l'acheteur (il notifie alors les
 * modifications du DCE et les réponses aux questions).
 */
model DceRetrievalSettings {
  id                String           @id @default(cuid())
  organizationId    String           @unique
  mode              DceRetrievalMode @default(DISABLED)
  firstName         String           @default("")
  lastName          String           @default("")
  email             String           @default("")
  phone             String           @default("")
  legalName         String           @default("")
  siret             String           @default("") // 14 chiffres
  address           String           @default("")
  address2          String           @default("")
  postalCode        String           @default("")
  city              String           @default("")
  /**
   * Acceptation des CGU des plateformes au nom de la société (prérequis au retrait automatique).
   */
  termsAcceptedAt   DateTime?
  termsAcceptedById String?
  /**
   * Retrait automatique à l'import des nouveaux avis (avant l'analyse automatique).
   */
  autoRetrieve      Boolean          @default(false)
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * Compte de l'entreprise sur une plateforme acheteur ; mot de passe chiffré (AES-256-GCM).
 */
model PlatformAccount {
  id             String       @id @default(cuid())
  organizationId String
  host           String // nom d'hôte, ex. www.marches-publics.info
  login          String
  passwordEnc    String
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, host])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  memberships     Membership[]
  sessions        Session[]
  assignedTenders Tender[]      @relation("TenderAssignee")
  comments        Comment[]
  auditLogs       AuditLog[]
  savedSearches   SavedSearch[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Session {
  id             String       @id // SHA-256 du jeton, jamais le jeton lui-même
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  ip             String?
  userAgent      String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Entreprise ─────────────────────────────

model CompanyProfile {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  legalName             String
  siren                 String?
  // Identité légale (formulaires DC1 / DC2, acte d'engagement)
  legalForm             String       @default("") // SAS, SARL, EI…
  nafCode               String       @default("") // code APE / NAF, ex. 62.01Z
  vatNumber             String       @default("") // n° de TVA intracommunautaire
  address               String       @default("")
  postalCode            String       @default("")
  city                  String       @default("")
  phone                 String       @default("")
  email                 String       @default("")
  legalRepName          String       @default("") // représentant légal / signataire habilité
  legalRepTitle         String       @default("") // qualité : Président, Gérant…
  country               String       @default("FR") // ISO 3166-1 alpha-2
  eligibleCountries     String[]     @default(["FR"])
  description           String       @default("")
  skills                String[]     @default([])
  technologies          String[]     @default([])
  certifications        String[]     @default([])
  headcount             Int?
  annualRevenueEur      Int?
  insuranceRc           Boolean      @default(false)
  canSubcontract        Boolean      @default(true)
  canJoinConsortium     Boolean      @default(true)
  minBudgetEur          Int?
  maxBudgetEur          Int?
  cpvCodes              String[]     @default([])
  keywords              String[]     @default([])
  dailyRates            Json         @default("{}") // { "Chef de projet": 750, ... }
  scoringWeights        Json         @default("{}") // surcharge des pondérations
  aiRules               Json         @default("{}") // règles de traitement IA : { common, analysis, section, compliance }
  methodology           String       @default("")
  qualityProcess        String       @default("")
  securityPolicy        String       @default("")
  gdprCommitments       String       @default("")
  ecoDesign             String       @default("")
  accessibility         String       @default("")
  allowAiDocumentUpload Boolean      @default(false) // consentement explicite à l'envoi des DCE au fournisseur IA
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CompanyReference {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  client         String
  clientType     String? // public / privé
  year           Int?
  amountEur      Int?
  durationMonths Int?
  description    String
  technologies   String[]     @default([])
  sector         String?
  isPublic       Boolean      @default(true) // citable dans un mémoire
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum CompanyDocType {
  KBIS
  URSSAF
  FISCALE
  ASSURANCE_RC
  RIB
  DC2
  BILANS
  REFERENCES
  CERTIFICATION
  POUVOIR
  AUTRE
}

/**
 * Pièce administrative de l'entreprise, réutilisée dans les dossiers de candidature.
 */
model CompanyDocument {
  id             String         @id @default(cuid())
  organizationId String
  type           CompanyDocType
  label          String
  filename       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String
  issuedAt       DateTime? // date de délivrance
  validUntil     DateTime? // fin de validité (null = sans échéance)
  uploadedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

// ───────────────────────────── Veille ─────────────────────────────

enum SourceKey {
  BOAMP
  TED
  APPROCH
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model SourceConfig {
  id             String       @id @default(cuid())
  organizationId String
  source         SourceKey
  enabled        Boolean      @default(true)
  settings       Json         @default("{}") // { daysBack, countries, extraKeywords }
  lastSyncAt     DateTime?
  lastStatus     SyncStatus?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source])
}

model SyncRun {
  id             String       @id @default(cuid())
  organizationId String
  source         SourceKey
  status         SyncStatus   @default(RUNNING)
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  fetched        Int          @default(0)
  created        Int          @default(0)
  updated        Int          @default(0)
  duplicates     Int          @default(0)
  errors         Json         @default("[]")
  trigger        String       @default("manual") // manual | cron
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
}

enum TenderStatus {
  DETECTED
  TO_ANALYZE
  QUALIFIED
  GO
  NO_GO
  IN_PREPARATION
  IN_VALIDATION
  READY_TO_SUBMIT
  SUBMITTED
  AWAITING_DECISION
  WON
  LOST
}

enum NoticeState {
  ACTIVE
  MODIFIED
  CANCELLED
  AWARDED
}

enum TenderOrigin {
  BOAMP
  TED
  APPROCH
  MANUAL
}

model Tender {
  id               String       @id @default(cuid())
  organizationId   String
  origin           TenderOrigin
  externalId       String // idweb BOAMP, notice-identifier TED, code APProch, uuid manuel
  publicationRef   String? // n° de publication officiel affichable
  procedureId      String? // identifiant de procédure eForms (dédoublonnage fort)
  dedupKey         String // empreinte acheteur+objet+date limite (dédoublonnage faible)
  duplicateOfId    String?
  title            String
  description      String       @default("")
  buyerName        String       @default("")
  buyerCountry     String? // ISO alpha-2
  region           String? // département / NUTS
  cpvCodes         String[]     @default([])
  estimatedValue   Decimal?     @db.Decimal(14, 2)
  currency         String?
  publishedAt      DateTime?
  deadlineAt       DateTime?
  procedureType    String?
  noticeType       String?
  contractType     String? // SERVICES, FOURNITURES, TRAVAUX
  durationMonths   Int?
  isPublicMarket   Boolean      @default(true)
  allowsConsortium Boolean?
  noticeUrl        String?
  documentsUrl     String?
  noticeState      NoticeState  @default(ACTIVE)
  status           TenderStatus @default(DETECTED)
  preScore         Int?
  assigneeId       String?
  raw              Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sourceUpdatedAt  DateTime?
  dceFetchedAt     DateTime? // dernier retrait automatique du DCE réussi
  dceFetchError    String? // dernier échec (ou limite) du retrait automatique

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?              @relation("TenderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  duplicateOf  Tender?            @relation("TenderDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates   Tender[]           @relation("TenderDuplicates")
  documents    TenderDocument[]
  analyses     TenderAnalysis[]
  scores       TenderScore[]
  proposals    Proposal[]
  pieces       ApplicationPiece[]
  comments     Comment[]

  @@unique([organizationId, origin, externalId])
  @@index([organizationId, status])
  @@index([organizationId, deadlineAt])
  @@index([organizationId, publishedAt])
  @@index([organizationId, procedureId])
  @@index([organizationId, dedupKey])
}

model SavedSearch {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  name           String
  filters        Json
  alertEnabled   Boolean      @default(false)
  lastAlertAt    DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}

// ───────────────────────────── DCE ─────────────────────────────

enum DocumentKind {
  RC
  CCTP
  CCAP
  AE
  BPU
  DPGF
  ANNEXE
  QR
  AVIS
  AUTRE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  NEEDS_OCR
  FAILED
}

model TenderDocument {
  id             String           @id @default(cuid())
  organizationId String
  tenderId       String
  parentId       String? // ZIP d'origine
  filename       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String
  kind           DocumentKind     @default(AUTRE)
  status         DocumentStatus   @default(UPLOADED)
  pageCount      Int?
  charCount      Int?
  error          String?
  uploadedById   String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender         Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  parent         TenderDocument?  @relation("DocumentParent", fields: [parentId], references: [id], onDelete: Cascade)
  children       TenderDocument[] @relation("DocumentParent")
  chunks         DocumentChunk[]

  @@unique([tenderId, sha256])
  @@index([organizationId, tenderId])
}

model DocumentChunk {
  id             String                       @id @default(cuid())
  organizationId String
  documentId     String
  index          Int
  pageStart      Int?
  pageEnd        Int?
  heading        String?
  text           String
  tokenEstimate  Int
  embedding      Unsupported("vector(1024)")? // colonne créée seulement si pgvector est disponible
  // colonne tsvector générée ajoutée par migration SQL (search_vector)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       TenderDocument               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([organizationId])
}

// ───────────────────────────── IA ─────────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model TenderAnalysis {
  id             String        @id @default(cuid())
  organizationId String
  tenderId       String
  status         JobStatus     @default(PENDING)
  model          String?
  promptVersion  String?
  result         Json?
  citationStats  Json? // { total, verified }
  error          String?
  requestedById  String?
  createdAt      DateTime      @default(now())
  finishedAt     DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender         Tender        @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  scores         TenderScore[]

  @@index([organizationId, tenderId, createdAt])
}

enum Recommendation {
  GO
  NO_GO
  TO_VERIFY
}

model TenderScore {
  id             String          @id @default(cuid())
  organizationId String
  tenderId       String
  analysisId     String?
  total          Int
  breakdown      Json // [{ key, label, weight, points, rationale }]
  eliminatory    Json // [{ key, label, status, detail }]
  recommendation Recommendation
  strengths      String[]        @default([])
  weaknesses     String[]        @default([])
  missingInfo    String[]        @default([])
  risks          String[]        @default([])
  justification  String
  weights        Json
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender         Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  analysis       TenderAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([organizationId, tenderId, createdAt])
}

model AiUsageLog {
  id               String       @id @default(cuid())
  organizationId   String
  operation        String // analyze_tender | generate_section | ...
  provider         String
  model            String
  promptVersion    String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  costUsd          Decimal      @default(0) @db.Decimal(10, 4)
  durationMs       Int          @default(0)
  success          Boolean
  error            String?
  refId            String?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ───────────────────────────── Réponse ─────────────────────────────

enum ProposalStatus {
  DRAFT
  GENERATING
  IN_REVIEW
  VALIDATED
}

enum SectionStatus {
  PENDING
  GENERATING
  AI_DRAFT
  EDITED
  VALIDATED
  FAILED
}

model Proposal {
  id                     String            @id @default(cuid())
  organizationId         String
  tenderId               String
  title                  String
  status                 ProposalStatus    @default(DRAFT)
  complianceGeneratingAt DateTime? // génération IA de la matrice en cours
  complianceError        String?
  createdById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender                 Tender            @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  sections               ProposalSection[]
  compliance             ComplianceItem[]

  @@index([organizationId, tenderId])
}

model ProposalSection {
  id         String                   @id @default(cuid())
  proposalId String
  key        String
  title      String
  order      Int
  guidance   String                   @default("") // critères du RC visés par la section
  content    String                   @default("")
  status     SectionStatus            @default(PENDING)
  sources    Json                     @default("[]")
  toValidate String[]                 @default([])
  version    Int                      @default(0)
  error      String?
  updatedAt  DateTime                 @updatedAt
  proposal   Proposal                 @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  versions   ProposalSectionVersion[]

  @@unique([proposalId, key])
}

model ProposalSectionVersion {
  id        String          @id @default(cuid())
  sectionId String
  version   Int
  content   String
  author    String // "ai:<model>" ou id utilisateur
  createdAt DateTime        @default(now())
  section   ProposalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, version])
}

enum ComplianceStatus {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  TO_VERIFY
}

model ComplianceItem {
  id          String           @id @default(cuid())
  proposalId  String
  order       Int
  requirement String
  response    String
  evidence    String           @default("")
  status      ComplianceStatus @default(TO_VERIFY)
  source      String           @default("")
  aiGenerated Boolean          @default(false) // réponse proposée par l'IA, à valider
  proposal    Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

// ───────────────────────────── Dossier de candidature ─────────────────────────────

enum PieceGroup {
  CANDIDATURE // pièces administratives (DC1, DC2, attestations…)
  OFFRE // pièces de l'offre (AE, BPU, mémoire…)
}

enum PieceStatus {
  TODO
  IN_PROGRESS
  DONE
  NOT_APPLICABLE
}

/**
 * Pièce à réunir pour déposer la candidature, avec son état d'avancement.
 */
model ApplicationPiece {
  id             String                 @id @default(cuid())
  organizationId String
  tenderId       String
  key            String // clé de la pièce usuelle (« dc1 », « memoire »…) ou « dce-<n> » / « custom-<id> »
  group          PieceGroup
  order          Int
  label          String
  detail         String                 @default("") // exigence telle que formulée dans le DCE
  source         String                 @default("") // référence documentaire
  fromDce        Boolean                @default(false)
  status         PieceStatus            @default(TODO)
  note           String                 @default("")
  updatedById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender         Tender                 @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  files          ApplicationPieceFile[]

  @@unique([tenderId, key])
  @@index([organizationId, tenderId])
}

/// Fichier propre à une consultation joint à une pièce du dossier (AE signé, BPU rempli, CV…).
model ApplicationPieceFile {
  id             String           @id @default(cuid())
  organizationId String
  pieceId        String
  filename       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String
  uploadedById   String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  piece          ApplicationPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)

  @@index([organizationId, pieceId])
}

// ───────────────────────────── Collaboration ─────────────────────────────

model Comment {
  id             String       @id @default(cuid())
  organizationId String
  tenderId       String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tender         Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenderId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
