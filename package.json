{
  "name": "tenderpilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "sync": "tsx --env-file=.env scripts/sync-once.ts",
    "db:dev": "tsx --env-file=.env scripts/dev-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "3.893.0",
    "@aws-sdk/s3-request-presigner": "3.893.0",
    "@hookform/resolvers": "5.2.2",
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "bullmq": "5.58.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "file-type": "21.0.0",
    "ioredis": "5.7.0",
    "jszip": "3.10.1",
    "lucide-react": "0.544.0",
    "mammoth": "1.11.0",
    "next": "15.5.4",
    "pino": "9.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.63.0",
    "recharts": "3.2.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "unpdf": "1.3.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.5.0-beta.15",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "6.16.2",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.2"
}
